# Copy this file to `.env` and fill in your bot credentials.
#
# 1. DM @BotFather on Telegram, /newbot, save the token below.
# 2. DM your new bot once, then curl
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the numeric chat.id from the JSON.
#
# .env is gitignored — the token is a secret; never commit it.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
