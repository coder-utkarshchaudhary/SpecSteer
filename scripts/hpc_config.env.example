# scripts/hpc_config.env.example
# ------------------------------
# Copy this file to scripts/hpc_config.env and fill every FILL_ME below.
# The wiki (docs/hpc_wiki.md) documents exactly how to obtain each value —
# do NOT guess. When you're done, `bash scripts/hpc_launch.sh` reads this
# file and everything runs from there.
#
# NEVER commit hpc_config.env — it contains the Telegram bot token and the
# wandb API key. .gitignore already excludes it.

# ---------------------------------------------------------------------------
# HPC access — TWO separate nodes, TWO separate filesystems.
#
#   LOGIN node   — ssh ${HPC_USER}@${HPC_HOST} from the lab. No qsub here.
#                  This is where the repo/venv/data get staged first.
#   COMPUTE node — reached with `ssh ${HPC_INNER_HOST}` FROM the login node
#                  (i.e. ssh in, then `ssh hpc`). This is where qsub lives
#                  and where jobs actually run.
# ---------------------------------------------------------------------------

# Your IITD LDAP username on the HPC (same as your SSH login).
HPC_USER=FILL_ME

# HPC login-node hostname (Padum is typical for IITD).
HPC_HOST=FILL_ME

# Absolute path to your $HOME on the HPC. Obtain via:
#   ssh ${HPC_USER}@${HPC_HOST} 'echo $HOME'
HPC_HOME=FILL_ME

# The hostname/alias used to reach the compute node FROM the login node
# (i.e. what you type after `ssh` once you're already logged into HPC_HOST).
# Verify with: ssh ${HPC_USER}@${HPC_HOST} 'ssh HPC_INNER_HOST echo ok'
# bash scripts/hpc_preflight.sh checks this for you (probe 2) and dumps the
# matching ~/.ssh/config "Host" block on the login node if it fails.
HPC_INNER_HOST="hpc"

# (Currently unused by any script — kept here only in case a future step
# needs scratch space explicitly. Safe to leave blank.)
HPC_SCRATCH=""

# Repo root ON THE LOGIN NODE — where scripts/hpc_launch.sh stages the repo,
# .venv, and data/processed/ from the lab. Defaults to $HPC_HOME/prism.
HPC_LOGIN_REPO_ROOT="${HPC_HOME}/prism"

# Repo root ON THE COMPUTE NODE — where jobs actually cd to and run.
# Defaults to the same path as HPC_LOGIN_REPO_ROOT (typical: both nodes use
# the same $HOME-relative layout even though the filesystems differ).
# Override only if the compute node's project directory has a different
# absolute path (e.g. it lives under a compute-local scratch mount).
HPC_COMPUTE_REPO_ROOT="${HPC_LOGIN_REPO_ROOT}"

# Back-compat alias some scripts still read; kept in sync with
# HPC_COMPUTE_REPO_ROOT automatically by scripts/hpc_common.sh — you don't
# need to set this yourself.
HPC_PROJECT_DIR="${HPC_COMPUTE_REPO_ROOT}"

# ---------------------------------------------------------------------------
# PBS scheduler
# ---------------------------------------------------------------------------

# GPU queue name. Ask Utkarsh which queue has A100 access, or list them via:
#   ssh -t ${HPC_USER}@${HPC_HOST} 'qstat -q'
# (the -t forces a login shell so qstat is on PATH; a plain non-interactive
#  ssh reports "qsub/qstat: command not found" on IITD's PBS Pro.)
HPC_QUEUE=FILL_ME

# Walltime per array element. Max is queue-dependent; 24:00:00 is safe.
HPC_WALLTIME="24:00:00"

# GPU resource select string. Adjust only if you know the queue's syntax.
HPC_SELECT="select=1:ncpus=8:ngpus=1:mem=64gb:centos=skylake"

# Which array elements to submit. Default = full 28-run grid.
# For a one-run smoke test set HPC_ARRAY_RANGE="1-1".
HPC_ARRAY_RANGE="1-28"

# Optional PBS project / accounting code. Leave empty if unused.
HPC_PROJECT_CODE=""

# ---------------------------------------------------------------------------
# Lab-side tunnel + relay
# ---------------------------------------------------------------------------

# Port for the reverse SSH tunnel + local notify_relay.py listener.
# Change only if 8765 is busy on either machine.
LAB_TUNNEL_PORT="8765"

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
# Ask Utkarsh for these on a private channel. Never commit them.

TELEGRAM_BOT_TOKEN=FILL_ME
TELEGRAM_CHAT_ID=FILL_ME

# ---------------------------------------------------------------------------
# Weights & Biases
# ---------------------------------------------------------------------------
# Utkarsh will share his API key. This is used by lab-side `wandb sync` after
# the job ends; the HPC job itself runs offline (WANDB_MODE=offline).

WANDB_API_KEY=FILL_ME
WANDB_PROJECT="hsi-pi-vae"
WANDB_ENTITY=""

# ---------------------------------------------------------------------------
# Data locations on the LAB machine
# ---------------------------------------------------------------------------

# Where the processed patches live on the lab machine.
LAB_DATA_ROOT="/media/yashdeep/New Volume 2/UTKARSH_CHAUDHARY_prism/prism/data/processed"

# Repo root on the lab machine. Default = the directory containing scripts/.
LAB_REPO_ROOT=""

# ---------------------------------------------------------------------------
# WiFi requirement
# ---------------------------------------------------------------------------
# The lab HPC reachable SSID. hpc_launch.sh sanity-checks this on macOS/Linux.
LAB_WIFI_SSID="mlr lab 5g"

# ---------------------------------------------------------------------------
# Wheels build
# ---------------------------------------------------------------------------
# Platform tag for `pip download` (must match the HPC's Python + OS + CUDA).
# Ask IITD HPC docs / Utkarsh; the default is right for Linux x86_64 + Python 3.11.
PIP_PLATFORM="manylinux2014_x86_64"
PIP_PYTHON_VERSION="311"
PIP_ABI="cp311"

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
EPOCHS="100"

# Extra flags forwarded to train/train.py inside every PBS array element.
# Leave empty for the first run. Once you've verified one full run passes,
# opt in to torch.compile with:
#   EXTRA_TRAIN_ARGS="--compile"
EXTRA_TRAIN_ARGS=""

# ---------------------------------------------------------------------------
# Smoke → Full flow
# ---------------------------------------------------------------------------
# The launcher first submits a SMOKE run (slot 1, SMOKE_EPOCHS epochs,
# checkpoints to model_smoke/). If it passes, it waits SMOKE_DELAY_SECS then
# submits the FULL grid. If it fails, it stops and sends the logs via Telegram.

# Epochs for the smoke run (only needs to complete — value doesn't matter much).
SMOKE_EPOCHS="5"

# Seconds to wait after smoke passes before submitting the full grid.
# Gives you a window to --stop if the smoke "passed but looked wrong".
SMOKE_DELAY_SECS="600"

# Array range for the full grid (after smoke passes).
FULL_ARRAY_RANGE="1-28"

# qstat poll interval while waiting for smoke to finish (seconds).
SMOKE_POLL_INTERVAL="30"

# ---------------------------------------------------------------------------
# Grid pull-back watcher
# ---------------------------------------------------------------------------
# Once the full grid is submitted, scripts/hpc_grid_watcher.sh polls qstat for
# each array slot and pulls that slot's checkpoint + logs back to the lab
# machine the moment it finishes (rather than waiting for all 28 runs to end).
# qstat poll interval for the full grid (seconds). A 24h array job doesn't
# need the smoke job's 30s cadence.
GRID_POLL_INTERVAL="600"

# ---------------------------------------------------------------------------
# Shipped .venv (two-node topology)
# ---------------------------------------------------------------------------
# If you rsynced a prebuilt .venv/ into the repo yourself (because the
# offline-wheels bootstrap didn't work on this cluster), leave this at "1":
# scripts/hpc_bootstrap.sh will verify it imports torch+wandb on the compute
# node and use it AS-IS — no venv creation, no pip install. Set to "0" to go
# back to the original wheels/ + offline pip install path.
USE_SHIPPED_VENV="1"

# ---------------------------------------------------------------------------
# Result return (compute node -> login node)
# ---------------------------------------------------------------------------
# Each PBS array element ends by calling scripts/hpc_push_results.sh, which
# ALWAYS writes a logs/pending_push/<idx> marker first (so the login-node
# collector, see COLLECTOR_INTERVAL below, is the single source of truth).
# Set this to "1" ONLY if `bash scripts/hpc_preflight.sh` (probe 6) confirms
# the compute node can reach the login node directly — otherwise every slot
# eats an SSH timeout for nothing and the collector is doing the real work
# anyway. Default "0" is safe everywhere.
PUSH_RESULTS_FROM_JOB="0"

# How often (seconds) the login-node collector tmux session polls the
# compute node for logs/pending_push/<idx> markers and pulls them back.
COLLECTOR_INTERVAL="120"
