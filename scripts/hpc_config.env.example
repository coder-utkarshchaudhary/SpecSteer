# scripts/hpc_config.env.example
# ------------------------------
# Copy this file to scripts/hpc_config.env and fill every FILL_ME below.
# The wiki (docs/hpc_wiki.md) documents exactly how to obtain each value —
# do NOT guess. When you're done, `bash scripts/hpc_launch.sh` reads this
# file and everything runs from there.
#
# NEVER commit hpc_config.env — it contains the Telegram bot token and the
# wandb API key. .gitignore already excludes it.

# ---------------------------------------------------------------------------
# HPC access
# ---------------------------------------------------------------------------

# Your IITD LDAP username on the HPC (same as your SSH login).
HPC_USER=FILL_ME

# HPC login-node hostname (Padum is typical for IITD).
HPC_HOST=FILL_ME

# Absolute path to your $HOME on the HPC. Obtain via:
#   ssh ${HPC_USER}@${HPC_HOST} 'echo $HOME'
HPC_HOME=FILL_ME

# Absolute path to your scratch space on the HPC. Usually /scratch/${HPC_USER}
# on IITD Padum. Verify via:
#   ssh ${HPC_USER}@${HPC_HOST} 'ls -d /scratch/${HPC_USER}'
HPC_SCRATCH=FILL_ME

# Where on the HPC the whole project lives. Defaults to $HPC_HOME/prism —
# override only if you keep the project on scratch instead of home.
HPC_PROJECT_DIR="${HPC_HOME}/prism"

# ---------------------------------------------------------------------------
# PBS scheduler
# ---------------------------------------------------------------------------

# GPU queue name. Ask Utkarsh which queue has A100 access, or list them via:
#   ssh ${HPC_USER}@${HPC_HOST} 'qstat -q'
HPC_QUEUE=FILL_ME

# Walltime per array element. Max is queue-dependent; 24:00:00 is safe.
HPC_WALLTIME="24:00:00"

# GPU resource select string. Adjust only if you know the queue's syntax.
HPC_SELECT="select=1:ncpus=8:ngpus=1:mem=64gb:centos=skylake"

# Which array elements to submit. Default = full 28-run grid.
# For a one-run smoke test set HPC_ARRAY_RANGE="1-1".
HPC_ARRAY_RANGE="1-28"

# Optional PBS project / accounting code. Leave empty if unused.
HPC_PROJECT_CODE=""

# ---------------------------------------------------------------------------
# Lab-side tunnel + relay
# ---------------------------------------------------------------------------

# Port for the reverse SSH tunnel + local notify_relay.py listener.
# Change only if 8765 is busy on either machine.
LAB_TUNNEL_PORT="8765"

# ---------------------------------------------------------------------------
# Telegram bot
# ---------------------------------------------------------------------------
# Ask Utkarsh for these on a private channel. Never commit them.

TELEGRAM_BOT_TOKEN=FILL_ME
TELEGRAM_CHAT_ID=FILL_ME

# ---------------------------------------------------------------------------
# Weights & Biases
# ---------------------------------------------------------------------------
# Utkarsh will share his API key. This is used by lab-side `wandb sync` after
# the job ends; the HPC job itself runs offline (WANDB_MODE=offline).

WANDB_API_KEY=FILL_ME
WANDB_PROJECT="hsi-pi-vae"
WANDB_ENTITY=""

# ---------------------------------------------------------------------------
# Data locations on the LAB machine
# ---------------------------------------------------------------------------

# Where the processed patches live on the lab machine. Default matches the
# scripts/run_overnight.sh sanity path.
LAB_DATA_ROOT="/media/yashdeep/New Volume 21/UTKARSH_CHAUDHARY_prism/data/processed"

# Repo root on the lab machine. Default = the directory containing scripts/.
LAB_REPO_ROOT=""

# ---------------------------------------------------------------------------
# WiFi requirement
# ---------------------------------------------------------------------------
# The lab HPC reachable SSID. hpc_launch.sh sanity-checks this on macOS/Linux.
LAB_WIFI_SSID="mlr lab 5g"

# ---------------------------------------------------------------------------
# Wheels build
# ---------------------------------------------------------------------------
# Platform tag for `pip download` (must match the HPC's Python + OS + CUDA).
# Ask IITD HPC docs / Utkarsh; the default is right for Linux x86_64 + Python 3.11.
PIP_PLATFORM="manylinux2014_x86_64"
PIP_PYTHON_VERSION="311"
PIP_ABI="cp311"

# ---------------------------------------------------------------------------
# Training
# ---------------------------------------------------------------------------
EPOCHS="100"

# Extra flags forwarded to train/train.py inside every PBS array element.
# Leave empty for the first run. Once you've verified one full run passes,
# opt in to torch.compile with:
#   EXTRA_TRAIN_ARGS="--compile"
EXTRA_TRAIN_ARGS=""

# ---------------------------------------------------------------------------
# Smoke → Full flow
# ---------------------------------------------------------------------------
# The launcher first submits a SMOKE run (slot 1, SMOKE_EPOCHS epochs,
# checkpoints to model_smoke/). If it passes, it waits SMOKE_DELAY_SECS then
# submits the FULL grid. If it fails, it stops and sends the logs via Telegram.

# Epochs for the smoke run (only needs to complete — value doesn't matter much).
SMOKE_EPOCHS="5"

# Seconds to wait after smoke passes before submitting the full grid.
# Gives you a window to --stop if the smoke "passed but looked wrong".
SMOKE_DELAY_SECS="600"

# Array range for the full grid (after smoke passes).
FULL_ARRAY_RANGE="1-28"

# qstat poll interval while waiting for smoke to finish (seconds).
SMOKE_POLL_INTERVAL="30"
