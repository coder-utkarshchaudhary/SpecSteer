#!/usr/bin/env bash
#PBS -N specsteer
#PBS -o logs/pbs.out
#PBS -e logs/pbs.err
#PBS -j oe
#PBS -m n
#
# scripts/hpc_pbs_job.pbs
# -----------------------
# PBS Pro array job for the 28-run ablation grid. One array element per grid
# slot. Slot -> (model, dataset, loss) resolved via scripts/grid_manifest.sh.
#
# NOTE: -q, -l select=, -l walltime=, and -J are injected by scripts/hpc_launch.sh
# so the same .pbs file works for the full 28-run grid and a smoke-test 1-1
# submission. Do NOT hard-code them here.
#
# Requires the following env from qsub -v:
#   HPC_PROJECT_DIR   absolute path to the project on the HPC
#   EPOCHS            number of epochs to train (100 for full grid)
#
# Per-array-element files:
#   logs/pbs_${PBS_ARRAY_ID}_${PBS_ARRAY_INDEX}.out      combined stdout+err
#   logs/train_<model>_<loss>_<dataset>_<ts>.log         RunLogger file
#   checkpoints/<DATASET>/<name>.pt                      best-val checkpoint

set -uo pipefail

# ---- resolve env ---------------------------------------------------------
: "${HPC_PROJECT_DIR:?HPC_PROJECT_DIR must be passed via qsub -v}"
: "${EPOCHS:=100}"

cd "${HPC_PROJECT_DIR}"

ARRAY_IDX="${PBS_ARRAY_INDEX:-1}"
JOB_ID="${PBS_JOBID:-standalone}"
HOST="$(hostname)"
TS="$(date +%Y%m%d-%H%M%S)"

PBS_LOG="logs/pbs_${JOB_ID//./_}_${ARRAY_IDX}.out"
mkdir -p logs checkpoints wandb model
exec > "${PBS_LOG}" 2>&1

echo "=========================================="
echo " PBS array job"
echo "  job_id     : ${JOB_ID}"
echo "  array_idx  : ${ARRAY_IDX}"
echo "  host       : ${HOST}"
echo "  cwd        : $(pwd)"
echo "  ts         : ${TS}"
echo "=========================================="

# ---- resolve slot -> (model, dataset, loss, ckpt_name) --------------------
# shellcheck source=/dev/null
source scripts/grid_manifest.sh
CFG="$(grid_lookup "${ARRAY_IDX}")"
MODEL="${CFG%%|*}"; REST="${CFG#*|}"
DATASET="${REST%%|*}"; REST="${REST#*|}"
LOSS="${REST%%|*}"
CKPT_NAME="${REST#*|}"
CKPT_PATH="model/${DATASET}/${CKPT_NAME}.pt"

echo "  model      : ${MODEL}"
echo "  dataset    : ${DATASET}"
echo "  loss       : ${LOSS}"
echo "  ckpt_name  : ${CKPT_NAME}"
echo "  ckpt_path  : ${CKPT_PATH}"
echo "  epochs     : ${EPOCHS}"

# ---- skip if a ckpt is already present -----------------------------------
if [[ -s "${CKPT_PATH}" ]]; then
    echo ">>> [skip] ${CKPT_PATH} exists; nothing to do."
    exit 0
fi

# ---- activate env --------------------------------------------------------
if [[ ! -d .venv ]]; then
    echo "!!! .venv/ missing. Run scripts/hpc_bootstrap.sh first."
    exit 4
fi
# shellcheck source=/dev/null
source .venv/bin/activate

# Load .env produced by bootstrap (for WANDB_MODE etc.). Never fail on missing.
if [[ -f .env ]]; then
    set -a
    # shellcheck source=/dev/null
    source .env
    set +a
fi

export PYTHONPATH="${PBS_O_WORKDIR:-$(pwd)}:${PYTHONPATH:-}"
export WANDB_MODE="${WANDB_MODE:-offline}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

echo ">>> python: $(which python)"
python -c "import torch; print(f'torch {torch.__version__}  cuda={torch.cuda.is_available()}  ndev={torch.cuda.device_count()}')"

# ---- launch training -----------------------------------------------------
# --compile is OFF by default: torch.compile occasionally trips on model
# variants that haven't been verified on this specific HPC's CUDA/PyTorch
# combination. Once one full run has completed cleanly, opt-in via:
#   qsub -v HPC_PROJECT_DIR=...,EPOCHS=100,EXTRA_TRAIN_ARGS='--compile' ...
NUM_WORKERS="${PBS_NCPUS_PER_JOB:-8}"

# Split EXTRA_TRAIN_ARGS on whitespace when qsub passes it in.
IFS=' ' read -r -a EXTRA_TRAIN_ARR <<< "${EXTRA_TRAIN_ARGS:-}"

set +e
python train/train.py \
    --model "${MODEL}" \
    --dataset "${DATASET}" \
    --loss "${LOSS}" \
    --epochs "${EPOCHS}" \
    --num-workers "${NUM_WORKERS}" \
    --ckpt-dir "model" \
    --wandb-project "${WANDB_PROJECT:-hsi-pi-vae}" \
    ${WANDB_ENTITY:+--wandb-entity "${WANDB_ENTITY}"} \
    "${EXTRA_TRAIN_ARR[@]}"
rc=$?
set -e

echo ""
echo "=========================================="
if [[ ${rc} -eq 0 ]]; then
    echo " PBS array element ${ARRAY_IDX} — OK  (rc=0)"
else
    echo " PBS array element ${ARRAY_IDX} — FAIL (rc=${rc})"
fi
echo "=========================================="
exit ${rc}
